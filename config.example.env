# ── 复制本文件为 config.env 再改 ──
#   cp config.example.env config.env

# 第三方 Claude API 供应商的网关地址(改成你自己的)
TARGET_HOST=10.0.0.1
TARGET_PORT=3000

# 本地监听端口。挑一个冷门端口避免和别的服务冲突。
# Claude Desktop 里就填 http://127.0.0.1:<LISTEN_PORT>/api
LISTEN_PORT=21434

# 转发引擎,留空则安装时交互选择:
#   socat = 裸 TCP 转发,最简单(推荐先试)
#   caddy = 反代并把 Host 头改回真实网关地址(网关按 Host 路由时用)
ENGINE=
